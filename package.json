{
  "name": "bskts-sdk-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:packages": "pnpm -r run check:package",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && node scripts/stage-publish.mjs",
    "release:dry": "pnpm run build && node scripts/stage-publish.mjs --dry-run"
  },
  "volta": {
    "node": "24.21.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.4",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "5.8.3",
    "vitest": "5.0.2"
  }
}
